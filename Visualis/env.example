# Agent #2 — Server + Agent + Model
# Copy to .env and set for local run or Docker.

# Model (vLLM or model mock): OpenAI-compatible chat completions base URL
# Qwen 2.5 Coder 1.5B Instruct (mocks/docker-compose.models vllm-gemma): port 8010
# DeepSeek Coder 1.3B Instruct (mocks/docker-compose.models vllm-qwen): port 8011
MODEL_URL=http://localhost:8010/v1
MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct
# Optional: HTTP basic auth for model server (if configured)
# If your model endpoint is protected, set these and configure the model server accordingly.
MODEL_USER=
MODEL_PASSWORD=

# Public snippet model route target (defaults to MODEL_URL if empty in server runtime)
PUBLIC_MODEL_URL=http://localhost:8010/v1
PUBLIC_MODEL_USER=
PUBLIC_MODEL_PASSWORD=

# Flapi: package run proxy
FLAPI_URL=http://localhost:4000

# Redis: agent stores run snippet/summary (12h TTL)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (used for initial generated snippets)
# Example endpoint: http://minio:9000
S3_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=visualis

# Agent: URL the main server uses to call the agent (default in-container)
AGENT_URL=http://127.0.0.1:8002

# Optional: libs root, static dir for SPA
# LIBS_ROOT=./libs
# STATIC_DIR=./static

# Base URL where the server is reachable (used by client or external systems and library injection)
# Example: http://localhost:8000
BASE_URL=

# Iframe data injection event name used for postMessage-based cube data delivery
# Example: VISUALIS_IFRAME_DATA
IFRAME_DATA_EVENT=VISUALIS_IFRAME_DATA

# Optional: for mocks/docker-compose.models vLLM (download from Hugging Face)
# HUGGING_FACE_HUB_TOKEN=hf_...
# Offline after first pull: HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
